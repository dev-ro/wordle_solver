rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Any authenticated user can submit feedback
    match /feedback/{document=**} {
      allow create: if request.auth != null;
      // Only allow reading for admin purposes (can be restricted further)
      allow read: if request.auth != null;
    }
    
    // Feedback subcollections
    match /feedback/missingWords/{document=**} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
    // Submissions collection for dictionary ingestion
    // Structure: /dictionary (collection) /submissions (document) /items (subcollection) /{docId}
    match /dictionary/submissions/items/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      // Updates are performed by backend functions service account
      allow update, delete: if false;
    }
    
    match /feedback/appImprovements/{document=**} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
  }
}
